{
  "configs": [
    {
      "title": "听歌统计",
      "config": "config.json",
      "preferences": [
        {
          "type": "button",
          "title": "导出 CSV",
          "summary": "弹出保存对话框，自选导出位置（UTF-8 BOM，Excel 可直接打开）",
          "arrow_type": "link",
          "on_click": "com.spwmods.waerwak.listenstats.StatsActions.exportCsvDialog"
        },
        {
          "type": "button",
          "title": "备份数据",
          "summary": "把统计与配置打包为 zip（含曲目字典/聚合/明细/配置）",
          "arrow_type": "link",
          "on_click": "com.spwmods.waerwak.listenstats.StatsActions.backupDataDialog"
        },
        {
          "type": "button",
          "title": "恢复数据",
          "summary": "从备份 zip 恢复（原数据会改名为 .bak 保留）",
          "arrow_type": "link",
          "on_click": "com.spwmods.waerwak.listenstats.StatsActions.restoreDataDialog"
        },
        {
          "type": "button",
          "title": "清空统计",
          "summary": "内存清零，事件日志改名为 .bak（可恢复）",
          "arrow_type": "none",
          "on_click": "com.spwmods.waerwak.listenstats.StatsActions.resetStats"
        },
        {
          "type": "button",
          "title": "悬浮按钮-安装",
          "summary": "显示右下角圆钮入口（并确保浮层已注入，需 CLASS_TRANSFORM）",
          "arrow_type": "none",
          "on_click": "com.spwmods.waerwak.listenstats.OverlayInjection.installOverlayFromConfig"
        },
        {
          "type": "button",
          "title": "悬浮按钮-卸载",
          "summary": "仅隐藏右下角圆钮；顶栏按钮与统计页仍可正常使用",
          "arrow_type": "none",
          "on_click": "com.spwmods.waerwak.listenstats.OverlayInjection.uninstallOverlayFromConfig"
        },
        {
          "type": "button",
          "title": "顶栏按钮-安装",
          "summary": "在标题栏 Quick 左侧添加统计入口按钮",
          "arrow_type": "none",
          "on_click": "com.spwmods.waerwak.listenstats.OverlayInjection.installTitlebarFromConfig"
        },
        {
          "type": "button",
          "title": "顶栏按钮-卸载",
          "summary": "移除标题栏的统计入口按钮",
          "arrow_type": "none",
          "on_click": "com.spwmods.waerwak.listenstats.OverlayInjection.uninstallTitlebarFromConfig"
        }
      ]
    }
  ]
}
