{
  "configs": [
    {
      "title": "入口",
      "config": "config.json",
      "preferences": [
        {
          "type": "button",
          "title": "打开听歌统计",
          "summary": "在宿主界面直接打开统计面板；任何入口不可用时都能用这里打开",
          "arrow_type": "arrow",
          "on_click": "com.spwmods.waerwak.listenstats.OverlayInjection.openStatsPanelFromConfig"
        },
        {
          "key": "showFloatingButton",
          "type": "switch",
          "title": "显示悬浮圆钮",
          "summary": "右下角那个「只露一点」的圆钮。默认开启；关闭后仍可用标题栏按钮或本页入口打开，保存后立即生效",
          "default_value": true
        },
        {
          "key": "showTitlebarButton",
          "type": "switch",
          "title": "显示标题栏按钮",
          "summary": "标题栏右侧的统计入口按钮。默认开启；关闭后仍可用悬浮圆钮或本页入口打开，保存后立即生效",
          "default_value": true
        }
      ]
    },
    {
      "title": "数据",
      "config": "config.json",
      "preferences": [
        {
          "type": "button",
          "title": "导出 CSV",
          "summary": "弹出保存对话框，自选导出位置（UTF-8 BOM，Excel 可直接打开）",
          "arrow_type": "link",
          "on_click": "com.spwmods.waerwak.listenstats.StatsActions.exportCsvDialog"
        },
        {
          "type": "button",
          "title": "备份数据",
          "summary": "把统计与配置打包为 zip（含曲目字典/聚合/明细/配置）",
          "arrow_type": "link",
          "on_click": "com.spwmods.waerwak.listenstats.StatsActions.backupDataDialog"
        },
        {
          "type": "button",
          "title": "恢复数据-覆盖当前",
          "summary": "用备份完整替换当前统计（原数据会改名为 .bak 保留）",
          "arrow_type": "link",
          "on_click": "com.spwmods.waerwak.listenstats.StatsActions.restoreDataDialog"
        },
        {
          "type": "button",
          "title": "恢复数据-合并当前",
          "summary": "保留现有统计，把备份里的播放明细并进来（按会话去重，可重复导入）",
          "arrow_type": "link",
          "on_click": "com.spwmods.waerwak.listenstats.StatsActions.mergeImportDialog"
        },
        {
          "type": "button",
          "title": "清空统计",
          "summary": "内存清零，事件日志改名为 .bak（可恢复）",
          "arrow_type": "none",
          "on_click": "com.spwmods.waerwak.listenstats.StatsActions.resetStats"
        }
      ]
    },
    {
      "title": "高级诊断",
      "config": "config.json",
      "preferences": [
        {
          "type": "button",
          "title": "写入诊断报告",
          "summary": "把版本、权限、界面接入状态与最近日志写到数据目录，反馈问题时附上它；不含歌名与音频路径",
          "arrow_type": "none",
          "on_click": "com.spwmods.waerwak.listenstats.StatsActions.writeDiagReport"
        }
      ]
    }
  ]
}
